{
    "schemaVersion": 1,
    "id": "${mod_id}",
    "version": "${version}",
    "name": "${mod_name}",
    "description": "${description}",
    "authors": [
        "${mod_author}"
    ],
    "contact": {
        "homepage": "https://fabricmc.net/",
        "sources": "https://github.com/FabricMC/fabric-example-mod"
    },
    "license": "${license}",
    "icon": "${mod_id}.png",
    "environment": "*",
    "entrypoints": {
        "main": [
          "com.coolerpromc.uncrafteverything.FabricUncraftEverything"
        ],
        "client": [
            "com.coolerpromc.uncrafteverything.FabricUncraftEverythingClient"
        ],
        "jei_mod_plugin": [
            "com.coolerpromc.uncrafteverything.compat.jei.UEJEIPlugin"
        ]
    },
    "mixins": [
        "${mod_id}.mixins.json",
        "${mod_id}.fabric.mixins.json"
    ],
    "accessWidener": "uncrafteverything.classtweaker",
    "depends": {
        "fabricloader": ">=${fabric_loader_version}",
        "fabric-api": "*",
        "minecraft": "${fabric_mc_version_range}",
        "java": ">=${java_version}",
        "coolerconfig": ">=26.1.2.16"
    },
    "suggests": {
        "another-mod": "*"
    }
}
  